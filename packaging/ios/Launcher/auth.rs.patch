+/// Ely.by Yggdrasil session join. Never send an Ely.by token to Microsoft services.
+fn elyby_join_server_once(session: &AuthSession, server_hash: &str) -> Result<(), JoinError> {
+    let body = join_request(session, server_hash);
+    match agent()
+        .post("https://authserver.ely.by/session/join")
+        .set("Content-Type", "application/json; charset=utf-8")
+        .send_string(&body)
+    {
+        Ok(_) => Ok(()),
+        Err(ureq::Error::Status(status, response)) => Err(JoinError::from_response(
+            status,
+            &response.into_string().unwrap_or_default(),
+        )),
+        Err(ureq::Error::Transport(e)) => {
+            log::warn!("Ely.by session join: {e}");
+            Err(JoinError::Unavailable)
+        }
+    }
+}
